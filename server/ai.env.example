# Copy to .local/ai.env. Loaded by the AI server only, never by Vite.
# Do not paste keys into chat, commit this local file, or use a VITE_* variable for secrets.
OPENAI_API_KEY=
AI_ENABLED=false
# Cumulative project test budget (USD), not a daily/monthly reset. Default zero makes no paid calls.
AI_TOTAL_BUDGET_USD=0
