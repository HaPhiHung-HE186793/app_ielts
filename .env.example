# Public browser configuration. Leave empty to keep the guest-only app.
# Copy to .env.local; never put a secret/service_role key in VITE_*.
# Public Auth URL only. Database credentials belong in Render, never in VITE variables.
VITE_NEON_AUTH_URL=

# Sentry: error tracking (optional, leave empty to disable)
# VITE_SENTRY_DSN is safe to be public — it is the Sentry project DSN (not secret)
VITE_SENTRY_DSN=
